APP_NAME=Instagram DM Automation
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/instagram/callback
# Leave blank until you confirm the version enabled for your Meta app.
# Graph paths are built as {META_GRAPH_BASE_URL}/{META_API_VERSION}/...
META_API_VERSION=
META_GRAPH_BASE_URL=
META_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
META_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
# Confirm these scopes in the Meta App Dashboard before requesting them.
META_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_FIELDS=comments

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# inline processes jobs in the API process (required until PostgreSQL exists).
# celery enqueues jobs for the worker process.
TASK_EXECUTION_MODE=inline

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

LOG_LEVEL=INFO

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

MOCK_EXTERNAL_SERVICES=true
SEED_DEMO_DATA=false

CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AUTOMATION_CREATE_PER_MINUTE=30
RATE_LIMIT_INSTAGRAM_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_PER_MINUTE=300

RETRY_BASE_SECONDS=0.5
RETRY_MAX_ATTEMPTS=5
